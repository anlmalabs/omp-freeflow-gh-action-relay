# Copy to .env and adjust. No secrets here — only pool shape and tuning.
#
# Comment syntax: full-line comments start with '#'; after an UNQUOTED value
# a whitespace-preceded '#' also starts an inline comment (e.g.
# `PROBE_TIMEOUT_MS=15000 # custom`). Quoted values run to the closing quote;
# a comment after the closing quote is ignored.
#
# How these values are consumed:
#   - generate-compose.sh sources this file (when present) at generation
#     time and bakes the relevant values into docker-compose.yml (relay
#     service environment + host binds). After editing, re-run
#     ./generate-compose.sh <count> [--with-tunnels] && docker compose up -d.
#     Values already set in the process environment take precedence.
#   - probe.mjs reads the process environment only. For manual runs use
#     `node --env-file=.env probe.mjs --once`; systemd installs get their
#     values from the unit's Environment= lines (setup.sh writes COUNT
#     there), NOT from this file.

# --- Pool shape ---
# Relay count: generator COUNT, the relay app's RELAY_COUNT, and the
# prober's pool size. The pool egresses directly from the host IP, so all
# relays share one egress address; relay N is host-published on 3100+N.
# The setup.sh wizard picks its own count from VPS sizing (pin one with
# `COUNT=5 ./setup.sh`) and intentionally ignores this value, so a copied
# example cannot over-commit a small VPS; manual runs
# (`COUNT=N ./generate-compose.sh`, probe.mjs) use it directly. If you
# change it on a wizard-installed host, update the unit's Environment=COUNT
# to match (or re-run setup.sh) — the prober must probe the deployed count.
COUNT=10
# BASE_PORT is the relay app's IN-CONTAINER listener base, and nothing else
# (server.mjs listens on 3001-3010 at the default). generate-compose.sh
# consumes it: the value is baked into the relay service environment and
# into the container port range, so changing it moves the in-container
# listeners. It never moves the host publish, which is always
# 3101-<3100+COUNT> regardless of this value. The tunnels dial the app by
# Docker service DNS (`http://relay:BASE_PORT+N`).
#
# The prober does NOT read BASE_PORT. probe.mjs derives the host base of
# relay 1 from the generated docker-compose.yml publish line (3101 as
# generated) and dials relay N at RELAY_BASE_PORT + (N-1); override that
# host base with RELAY_BASE_PORT below.
# BASE_PORT=3000
# Comma-separated allowlist for the x-relay-target header — the relay
# refuses any request whose target is not on this list.
RELAY_ALLOWED_TARGETS=https://opencode.ai,https://api.kilo.ai
# Host bind for the generated compose. Defaults to 127.0.0.1 (loopback only);
# set an address explicitly to expose deliberately.
#   INGRESS_BIND relay router (3101+; mesh mode only — tunnels mode does not
#                publish it)
# The setup wizard sets INGRESS_BIND to the VPS Tailscale IP in mesh mode.
# INGRESS_BIND=127.0.0.1

# --- relay throttle probe (probe.mjs) ---
# Detection only: no docker calls, no container restarts, no proxy layer —
# every probe goes HTTP-direct from the host to the relay router. probe.mjs
# dials each relay from the host and sends a real streaming inference request
# per model, then reports failures and upstream HTTP 429 (rate-limit)
# responses. The pool shares one egress IP, so there is nothing to rotate.
# Address of the relay router as seen from the probe host. Leave unset to let
# probe.mjs parse the generated docker-compose.yml publish line (`<bind>` of
# `- "<bind>:3101-3110:3001-3010"`), which is how a mesh install published on
# a Tailscale IP gets probed there instead of at loopback. The safe fallback
# is 127.0.0.1. The WARP-era bridge address is gone with the WARP containers.
# RELAY_HOST=127.0.0.1
# Host-published port of relay 1; relay N is probed at RELAY_BASE_PORT +
# (N-1). Normally left unset: probe.mjs reads it from the generated
# docker-compose.yml publish line (3101 as generated). Set it only when the
# router is published on a different host port range.
# RELAY_BASE_PORT=3101
# Upstream the probes go through (default https://api.kilo.ai — the Kilo
# gateway, keyless-capable and rate-limited per egress; OpenCode's Zen free
# tier refuses non-OpenCode clients outright since 2026-10-14).
PROBE_TARGET=https://api.kilo.ai
PROBE_CHAT_PATH=/api/gateway/chat/completions
PROBE_RESPONSES_PATH=/api/gateway/responses
# Comma-separated models to probe (PROBE_MODEL is the legacy single-model alias).
PROBE_MODELS=nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free,dots-studio/dots-3-note-preview:free
# Subset of probe models that use the Responses API shape.
RESPONSES_MODELS=dots-studio/dots-3-note-preview:free
# Model timed for the slow-relay report. Observability only: a slow pass is
# reported, never rotated away.
SPEED_MODEL=nvidia/nemotron-3.5-lightning:free
# Reporting threshold for a pool-wide 429 wave: how many relays must 429
# before the model is described as upstream quota on the shared egress rather
# than per-relay throttling. Default is max(8, COUNT-1) (9 at COUNT=10).
# It does not change the exit code — any 429 raises exit 1, wave or not.
GLOBAL_QUOTA_GUARD=9
# Per-probe HTTP timeout in ms.
PROBE_TIMEOUT_MS=30000
# Seconds between passes with --loop.
INTERVAL_S=300
# Optional append-only log file (stdout always logs regardless).
KEEP_COLD_LOG=
# Log rotation caps in bytes.
KEEP_COLD_LOG_MAX_BYTES=2097152
KEEP_COLD_LOG_KEEP_BYTES=204800
