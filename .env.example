# Copy to .env and adjust. No secrets here — only pool shape and tuning.
# Relay app (server.mjs) and compose generator read these at startup;
# keep-cold.mjs reads its block on every run.

# --- Relay app ---
# Number of relay listeners; relay N listens on BASE_PORT+N.
RELAY_COUNT=10
# Base port; relay N listens on BASE_PORT+N (3001..3010 at defaults).
BASE_PORT=3000
# Comma-separated allowlist for the x-relay-target header.
RELAY_ALLOWED_TARGETS=https://opencode.ai,https://api.kilo.ai
# Optional per-relay upstream override (defaults: warp-N:1080).
# WARP_HOST_1=warp-1
# WARP_PORT_1=1080

# --- Compose generator (generate-compose.sh) ---
# COUNT env or first arg; integer 1..64, default 10. Regenerate with:
#   COUNT=10 ./generate-compose.sh
COUNT=10

# --- keep-cold probe (keep-cold.mjs) ---
# NOTE: keep-cold uses COUNT (not RELAY_COUNT) for the pool size.
RELAY_HOST=10.244.0.100
COUNT=10
# Comma-separated models to probe (PROBE_MODEL is the legacy single-model alias).
PROBE_MODELS=nemotron-3.5-lightning-free,mimo-v2.5-free,muse-spark-1.3-contributor-free
# Subset of probe models that use the Responses API shape.
RESPONSES_MODELS=muse-spark-1.2-contributor-free,muse-spark-1.3-contributor-free
# Model timed for the slow-relay check.
SPEED_MODEL=muse-spark-1.3-contributor-free
# Slow threshold in ms; 0 disables the speed check.
SLOW_THRESHOLD_MS=0
# Extra rotations when only the speed check fails.
SLOW_MAX_ROTATIONS=2
# Cap on relays rotated for a pool-wide 429 wave. Default 9 (= COUNT - 1 at
# COUNT=10): several recycled egress addresses can come up throttled at once,
# and a low guard would mistake that for upstream quota and skip rotation.
GLOBAL_QUOTA_GUARD=9
# Prefix of the WARP client containers (warp-relay-warp-N by default).
CONTAINER_PREFIX=warp-relay-warp-
# How long to wait for a restarted WARP client to report Connected.
READY_TIMEOUT_MS=180000
# Per-probe HTTP timeout in ms.
PROBE_TIMEOUT_MS=30000
# Max restarts per relay when probes return 429.
MAX_ROTATIONS=4
# How many relays to rotate concurrently.
ROTATE_CONCURRENCY=3
# Seconds between passes with --loop.
INTERVAL_S=300
# Optional append-only log file (stdout always logs regardless).
KEEP_COLD_LOG=
# Log rotation caps in bytes.
KEEP_COLD_LOG_MAX_BYTES=2097152
KEEP_COLD_LOG_KEEP_BYTES=204800
